# Copie para desenvolvimento local:
#   copy .env.example .env.local
# Docker Compose também lê .env na raiz (opcional):
#   copy .env.example .env

# Chave da API Gemini (opcional por enquanto)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# URL pública do app
APP_URL="http://localhost:3000"

# Portas no host (docker compose)
# APP_PORT=3000
# API_PORT=4000
# POSTGRES_PORT=5432

# PostgreSQL (usado pelo serviço api no Docker)
POSTGRES_USER=aplica
POSTGRES_PASSWORD=aplica
POSTGRES_DB=aplica_pro
DATABASE_URL=postgresql://aplica:aplica@localhost:5432/aplica_pro

# Proxy do Vite para a API (Docker usa http://api:4000)
VITE_API_PROXY=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Sessão JWT (mínimo 32 caracteres em produção; só no servidor da API)
JWT_SECRET=altere-esta-chave-com-pelo-menos-32-caracteres-aleatorios

# --- Apenas desenvolvimento local (.env.local, nunca commitar em produção) ---
# ADMIN_EMAIL=aplica-pro@admin.com.br
# ADMIN_PASSWORD=admin123

# --- Produção (somente no servidor da API, nunca no frontend) ---
# NODE_ENV=production
# APP_ENV=production
# ADMIN_EMAIL=email-secreto@suaempresa.com
# ADMIN_PASSWORD=senha-forte-aleatoria
# ENABLE_ADMIN_BOOTSTRAP=true
# ADMIN_BUSINESS_NAME=Nome discreto da conta
