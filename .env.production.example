# Copie para .env.production na raiz do projeto:
#   copy .env.production.example .env.production
#
# Depois suba em produção:
#   npm run docker:prod

# URL pública do app (usada pela API para CORS)
APP_URL=https://seu-dominio.com.br
CORS_ORIGIN=https://seu-dominio.com.br

# PostgreSQL — use senhas fortes em produção
POSTGRES_USER=aplica
POSTGRES_PASSWORD=ALTERE_SENHA_FORTE_AQUI
POSTGRES_DB=aplica_pro
# POSTGRES_PORT=5432

# Sessão JWT (obrigatório, mínimo 32 caracteres)
JWT_SECRET=ALTERE_COM_STRING_ALEATORIA_DE_PELO_MENOS_32_CARACTERES

# Conta administrativa (somente no servidor)
ADMIN_EMAIL=admin@suaempresa.com.br
ADMIN_PASSWORD=ALTERE_SENHA_ADMIN_FORTE
ADMIN_BUSINESS_NAME=Gestão do Sistema

# Na primeira implantação, defina true para criar/atualizar o admin; depois volte para false
ENABLE_ADMIN_BOOTSTRAP=true

# Opcional — chave Gemini se usar recursos de IA no frontend
# GEMINI_API_KEY=
